# Google Play Release İmzalama ve Üretim Yapılandırması Örneği
# Bu dosyayı 'keystore.properties' olarak kopyalayın ve kendi bilgilerinizi girin.
# 'keystore.properties' dosyası .gitignore içindedir, asla repo'ya commit edilmez.

# 1. Release Keystore Bilgileri (Android Studio veya keytool ile üretilmiş)
storeFile=/tam/dosya/yolu/release-key.jks
storePassword=keystore_sifreniz
keyAlias=anahtar_takma_adiniz
keyPassword=anahtar_sifreniz

# 2. AdMob Üretim Kimlikleri (Google AdMob konsolundan alınan gerçek kimlikler)
# Belirtilmezse varsayılan Google test ID'leri kullanılır.
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
admobBannerId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admobInterstitialId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admobRewardedInterstitialId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
